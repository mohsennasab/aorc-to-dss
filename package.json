{
  "name": "aorctodss-geolibre",
  "version": "0.2.0",
  "description": "A GeoLibre plugin for preparing AORC meteorology in HEC-DSS",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.geolibre.config.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "geolibre",
    "aorc",
    "hec-dss",
    "hydrology",
    "meteorology"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
